# JusticeAI Backend Environment Configuration

# Server
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# CORS Configuration (allowed origins separated by comma)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Timeout Configuration (in milliseconds)
AI_TIMEOUT_MS=15000
REQUEST_TIMEOUT_MS=20000

# Database Configuration (PostgreSQL + Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/justiceai_db?schema=public

# AI / RAG Service URL (if deployed standalone)
AI_SERVICE_URL=http://localhost:8000

# Google Gemini API Key (accessed server-side only)
GEMINI_API_KEY=your_gemini_api_key_here
