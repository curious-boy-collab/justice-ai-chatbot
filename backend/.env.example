# JusticeAI Backend Environment Configuration

# Server
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# CORS Configuration (allowed origins separated by comma)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database Configuration (PostgreSQL + Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/justiceai_db?schema=public

# AI / RAG Service URL (Nitin's AI service)
AI_SERVICE_URL=http://localhost:8000

# Google Gemini API Key (if accessed directly or via backend bridge)
GEMINI_API_KEY=your_gemini_api_key_here
