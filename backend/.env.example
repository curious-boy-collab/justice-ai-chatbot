# =================================================================
# JusticeAI Backend Environment Configuration
# Ministry of Law and Justice, Department of Justice, GoI
# =================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# CORS Configuration (comma-separated origins allowed to make browser requests)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Security & Rate Limiting (in-memory sliding window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Request Timeouts (in milliseconds)
AI_TIMEOUT_MS=15000
REQUEST_TIMEOUT_MS=20000

# Database Configuration (PostgreSQL + Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/justiceai_db?schema=public

# Standalone AI / Python Service URL (if decoupled from Node.js)
AI_SERVICE_URL=http://localhost:8000

# Google Gemini API Key
# IMPORTANT: This key is strictly server-side. It is NEVER exposed to the client or returned in API responses.
GEMINI_API_KEY=your_gemini_api_key_here
