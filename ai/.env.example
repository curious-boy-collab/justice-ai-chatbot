# JusticeAI – AI / RAG Module Environment Configuration Template
# Copy this file to .env before running live AI tests.
# NEVER commit the actual .env file to Git.

# Gemini API Configuration (Backend-only secret)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Generation Parameters
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=1024

# RAG & Retrieval Settings
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.3
RAG_EMBEDDING_MODEL=text-embedding-004

# Service Port (if run as standalone microservice)
AI_SERVICE_PORT=5001
NODE_ENV=development
